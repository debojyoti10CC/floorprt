# All deployed assets are test collateral. Local Anvil is the default.
FLOOR_RPC_URL=http://127.0.0.1:8545
FLOOR_API_PORT=8787
FLOOR_WEB_ORIGINS=
NEXT_PUBLIC_FLOOR_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_FLOOR_CHAIN_ID=31337
# Set the read API origin for hosted static builds. Local development uses :8787 automatically.
NEXT_PUBLIC_FLOOR_API_URL=
# Local Anvil accounts and faucet are shown only when explicitly enabled.
NEXT_PUBLIC_ENABLE_LOCAL_DEMO_UI=false
# Include /ops on static builds to finalize configured Chainlink-feed observations.
NEXT_PUBLIC_ENABLE_OPERATIONS_UI=false
# Optional Arkiv Rabdi public RPC key. Restrict it to your deployed web origin.
# It is a public browser key, never a wallet secret or deployer key.
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
# Optional for pnpm dev:positions in .env.positions.local. Use a funded loopback Arkiv devnet (chain 1337).
NEXT_PUBLIC_AQRA_LOCAL_ARKIV_URL=
# Server-only Swarm Bee endpoint and usable postage batch for public assessment files.
# Never expose the Bee endpoint, postage batch ID, or API token to browser code.
SWARM_BEE_URL=http://127.0.0.1:1633
SWARM_POSTAGE_BATCH_ID=
SWARM_BEE_API_TOKEN=
# Set true only when using a loopback Bee dev-mode node.
SWARM_DEV_MODE=false
# Public testnet deployment uses a wallet-controlled keystore or externally
# supplied DEPLOYER_PRIVATE_KEY, never committed or exposed to the API/browser.
