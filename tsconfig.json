{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noEmit": true, "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "packages/*/src/**/*.ts", "apps/api/**/*.ts", "services/**/*.ts", "e2e/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "packages/contracts/lib", "apps/web", "dist"]
}
